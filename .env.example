# Supabase
VITE_SUPABASE_URL=
# Client (browser) key. New-format projects use a publishable key (sb_publishable_...).
# VITE_SUPABASE_ANON_KEY is an alias kept for backwards compatibility — set both to
# the same publishable key, OR (legacy projects) set VITE_SUPABASE_ANON_KEY only.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets. NEVER prefix these with VITE_ — Vite inlines VITE_* vars
# into the browser bundle, which would leak them publicly.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack
# NOTE: .env only applies locally. On Vercel, set these in the dashboard:
# Settings → Environment Variables → add for Production (and Preview).
# Use pk_live_... / sk_live_... for live mode, pk_test_... / sk_test_... for testing.
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# App
# Base URL of the deployed app. Used for the Paystack callback redirect
# (users land on <APP_URL>/payments/verify after checkout) and as fallback
# origin when no Origin/Forwarded header is present.
APP_URL=https://myapexlaprat.vercel.app

# Paystack callback + webhook URLs (set in the Paystack dashboard):
#   Callback: <APP_URL>/payments/verify
#   Webhook:  <APP_URL>/api/payments/webhook
#   (the nested webhook URL is preserved by a vercel.json rewrite that serves it
#    from the top-level api/payments-webhook.js function)

# Secrets needed ONLY to run migrations locally (Supabase Management API PAT):
# SUPABASE_ACCESS_TOKEN=sbp_...
#
# Do NOT add server secrets here with a VITE_ prefix, and do NOT keep stale
# VITE_-prefixed keys for removed features (e.g. VITE_GEMINI_API_KEY currently
# sits in the local .env but is referenced by NO code anymore; it was only used
# by api/generate-question.js, which was deleted in Phase 6). Remove it from
# .env and from the Vercel dashboard so it never ships in a bundle.


# Web Push (VAPID) — Anonymous room notifications.
# Server-only. Generate a keypair once with: npx web-push generate-vapid-keys
# (requires the `web-push` dependency). Set all three on Vercel too, or push
# stays a graceful no-op. VAPID_SUBJECT must be a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Development
VITE_DASHBOARD_DEV_MODE=false

# Google AdSense — CONTROLLED placements only.
# Ads are permitted ONLY on: Dashboard, Community, Voting. Every other screen
# (active quiz, quiz setup/results, auth, profile, settings, marketplace,
# payments, admin, 1v1, unknown routes) is blocked in code by the centralized
# policy in src/config/ads.js — the loader script is never even requested there.
#
# The publisher id (ca-pub-...) is built into src/config/ads.js. Leave the
# VITE_ADSENSE_CLIENT override EMPTY unless you need a different account (e.g.
# staging). The manager lazy-loads the script on the first allowed route and
# guarantees a single <script> tag.
VITE_ADSENSE_CLIENT=
# One ad slot per allowed placement. Create an in-page ad unit in the AdSense
# dashboard for each, then paste the slot id here. An empty slot id = no ad.
VITE_ADSENSE_SLOT_DASHBOARD=
VITE_ADSENSE_SLOT_COMMUNITY=
VITE_ADSENSE_SLOT_VOTING=
