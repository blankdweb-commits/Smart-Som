[
  { "id": "cc-1", "subject": "Critical Care", "topic": "Hemodynamics", "question": "Normal Mean Arterial Pressure (MAP) range?", "answer": "70 - 100 mmHg.", "hint": "Average blood pressure.", "difficulty": "Moderate", "isImportant": true },
  { "id": "cc-2", "subject": "Critical Care", "topic": "Hemodynamics", "question": "Formula for MAP?", "answer": "[Systolic BP + (2 x Diastolic BP)] / 3.", "hint": "Weighted average.", "difficulty": "Hard", "isImportant": true },
  { "id": "cc-3", "subject": "Critical Care", "topic": "Shock", "question": "Definition of 'Hypovolemic Shock'?", "answer": "Shock resulting from a significant loss of blood or fluid volume.", "hint": "Low volume.", "difficulty": "Easy", "isImportant": true },
  { "id": "cc-4", "subject": "Critical Care", "topic": "Shock", "question": "Classic sign of 'Septic Shock'?", "answer": "Hypotension unresponsive to fluid resuscitation, fever, and elevated lactic acid.", "hint": "Systemic infection.", "difficulty": "Moderate", "isImportant": true },
  { "id": "cc-5", "subject": "Critical Care", "topic": "Ventilation", "question": "What is 'PEEP' in mechanical ventilation?", "answer": "Positive End-Expiratory Pressure; keeps alveoli open at the end of expiration.", "hint": "Prevents collapse.", "difficulty": "Moderate", "isImportant": true },
  { "id": "cc-6", "subject": "Critical Care", "topic": "Cardiac", "question": "Lethal cardiac rhythm: 'Ventricular Fibrillation'?", "answer": "Disorganized electrical activity causing the ventricles to quiver without pumping.", "hint": "Needs defib.", "difficulty": "Easy", "isImportant": true },
  { "id": "cc-7", "subject": "Critical Care", "topic": "Cardiac", "question": "Treatment for 'Symptomatic Bradycardia'?", "answer": "Atropine or transcutaneous pacing.", "hint": "Speed it up.", "difficulty": "Moderate", "isImportant": true },
  { "id": "cc-8", "subject": "Critical Care", "topic": "Neuro", "question": "Cushing's Triad (sign of increased ICP)?", "answer": "Bradycardia, Hypertension (widening pulse pressure), and Irregular Respirations.", "hint": "Late sign of pressure.", "difficulty": "Hard", "isImportant": true },
  { "id": "cc-9", "subject": "Critical Care", "topic": "Renal", "question": "Indication for Dialysis (AEIOU)?", "answer": "Acidosis, Electrolytes (K+), Ingestion/Toxins, Overload (fluid), Uremia.", "hint": "When kidneys fail.", "difficulty": "Hard", "isImportant": true },
  { "id": "cc-10", "subject": "Critical Care", "topic": "ABGs", "question": "Interpret: pH 7.25, CO2 55, HCO3 24.", "answer": "Respiratory Acidosis.", "hint": "Low pH, High CO2.", "difficulty": "Moderate", "isImportant": true },
  { "id": "cc-11", "subject": "Critical Care", "topic": "ABGs", "question": "Interpret: pH 7.50, CO2 30, HCO3 23.", "answer": "Respiratory Alkalosis.", "hint": "High pH, Low CO2.", "difficulty": "Moderate", "isImportant": true },
  { "id": "cc-12", "subject": "Critical Care", "topic": "Ventilation", "question": "Risk of high FIO2 (Fraction of Inspired Oxygen)?", "answer": "Oxygen toxicity and absorption atelectasis.", "hint": "Too much O2.", "difficulty": "Hard", "isImportant": false },
  { "id": "cc-13", "subject": "Critical Care", "topic": "Shock", "question": "Definition of 'Neurogenic Shock'?", "answer": "Loss of sympathetic tone due to spinal cord injury, resulting in bradycardia and hypotension.", "hint": "The exception shock.", "difficulty": "Hard", "isImportant": true },
