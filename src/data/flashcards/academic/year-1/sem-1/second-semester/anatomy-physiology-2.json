  { "id": "ap2-30", "subject": "Anatomy & Physiology", "topic": "Respiratory", "question": "What drives the normal breathing reflex in healthy people?", "answer": "Increase in CO2 levels (Hypercapnia).", "hint": "Partial pressure of CO2.", "difficulty": "Hard", "isImportant": true },
  { "id": "ap2-31", "subject": "Anatomy & Physiology", "topic": "Digestive", "question": "Function of the Pancreas (Exocrine)?", "answer": "Production of digestive enzymes (amylase, lipase, proteases) and bicarbonate.", "hint": "Neutralizes acid.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-32", "subject": "Anatomy & Physiology", "topic": "Digestive", "question": "Function of the Liver?", "answer": "Detoxification, protein synthesis, bile production, glycogen storage.", "hint": "Multitasking organ.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-33", "subject": "Anatomy & Physiology", "topic": "Urinary", "question": "Hormone released by kidneys to stimulate RBC production?", "answer": "Erythropoietin (EPO).", "hint": "Red cell maker.", "difficulty": "Hard", "isImportant": true },
