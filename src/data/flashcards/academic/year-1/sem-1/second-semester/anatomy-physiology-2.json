[
  { "id": "ap2-1", "subject": "Anatomy & Physiology", "topic": "Endocrine System", "question": "What is the 'Master Gland'?", "answer": "Pituitary gland (Hypophysis).", "hint": "Controlled by hypothalamus.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-2", "subject": "Anatomy & Physiology", "topic": "Endocrine System", "question": "Hormone that lowers blood glucose?", "answer": "Insulin (produced by Beta cells of Pancreas).", "hint": "Anabolic hormone.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-3", "subject": "Anatomy & Physiology", "topic": "Endocrine System", "question": "Hormone that raises blood glucose?", "answer": "Glucagon (produced by Alpha cells of Pancreas).", "hint": "Catabolic hormone.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-4", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "Which chamber of the heart has the thickest wall?", "answer": "Left Ventricle.", "hint": "Pumps to systemic circuit.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-5", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "The 'Pacemaker' of the heart?", "answer": "Sinoatrial (SA) Node.", "hint": "Upper right atrium.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-6", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "Sequence of Cardiac Conduction?", "answer": "SA Node -> AV Node -> Bundle of His -> Purkinje Fibers.", "hint": "SA to AV to fibers.", "difficulty": "Hard", "isImportant": true },
  { "id": "ap2-7", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "Define Cardiac Output (CO).", "answer": "CO = Stroke Volume x Heart Rate.", "hint": "Volume per minute.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-8", "subject": "Anatomy & Physiology", "topic": "Lymphatic", "question": "Largest lymphatic organ?", "answer": "The Spleen.", "hint": "Left upper quadrant.", "difficulty": "Easy", "isImportant": false },
  { "id": "ap2-9", "subject": "Anatomy & Physiology", "topic": "Immune", "question": "Difference between Innate and Adaptive immunity?", "answer": "Innate is non-specific/fast; Adaptive is specific/slow/memory-based.", "hint": "Born with vs acquired.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-10", "subject": "Anatomy & Physiology", "topic": "Respiratory", "question": "Primary muscle of inspiration?", "answer": "Diaphragm.", "hint": "Dome-shaped muscle.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-11", "subject": "Anatomy & Physiology", "topic": "Respiratory", "question": "Where does gas exchange occur?", "answer": "Alveoli (Respiratory membrane).", "hint": "Air sacs.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-12", "subject": "Anatomy & Physiology", "topic": "Respiratory", "question": "What is 'Surfactant'?", "answer": "A lipid/protein mixture that reduces surface tension in alveoli.", "hint": "Prevents collapse.", "difficulty": "Hard", "isImportant": true },
  { "id": "ap2-13", "subject": "Anatomy & Physiology", "topic": "Digestive", "question": "Where does most nutrient absorption occur?", "answer": "Small Intestine (specifically the Jejunum).", "hint": "Villi and microvilli.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-14", "subject": "Anatomy & Physiology", "topic": "Digestive", "question": "Function of Bile?", "answer": "Emulsification of fats.", "hint": "Produced by liver, stored in gallbladder.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-15", "subject": "Anatomy & Physiology", "topic": "Digestive", "question": "The three parts of the Small Intestine?", "answer": "Duodenum, Jejunum, Ileum.", "hint": "DJ I.", "difficulty": "Easy", "isImportant": false },
  { "id": "ap2-16", "subject": "Anatomy & Physiology", "topic": "Urinary", "question": "The functional unit of the kidney?", "answer": "Nephron.", "hint": "Million per kidney.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-17", "subject": "Anatomy & Physiology", "topic": "Urinary", "question": "Where does filtration occur in the nephron?", "answer": "Glomerulus / Bowman's Capsule.", "hint": "Renal corpuscle.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-18", "subject": "Anatomy & Physiology", "topic": "Reproductive", "question": "Where does fertilization usually occur?", "answer": "Fallopian Tube (Ampulla).", "hint": "Uterine tube.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-19", "subject": "Anatomy & Physiology", "topic": "Reproductive", "question": "Primary male sex hormone?", "answer": "Testosterone.", "hint": "Androgen.", "difficulty": "Easy", "isImportant": false },
  { "id": "ap2-20", "subject": "Anatomy & Physiology", "topic": "Reproductive", "question": "Primary female sex hormones?", "answer": "Estrogen and Progesterone.", "hint": "Ovarian hormones.", "difficulty": "Easy", "isImportant": false },
  { "id": "ap2-21", "subject": "Anatomy & Physiology", "topic": "Endocrine", "question": "Hormone that stimulates uterine contractions?", "answer": "Oxytocin.", "hint": "Posterior pituitary.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-22", "subject": "Anatomy & Physiology", "topic": "Endocrine", "question": "What is the function of ADH (Antidiuretic Hormone)?", "answer": "Promotes water reabsorption in the kidneys.", "hint": "Vasopressin.", "difficulty": "Hard", "isImportant": true },
  { "id": "ap2-23", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "Difference between Arteries and Veins?", "answer": "Arteries carry blood away from heart (usually oxygenated); Veins carry blood toward heart (usually deoxygenated).", "hint": "Artery = Away.", "difficulty": "Easy", "isImportant": true },
  { "id": "ap2-24", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "The only artery carrying deoxygenated blood?", "answer": "Pulmonary Artery.", "hint": "To the lungs.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-25", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "The only vein carrying oxygenated blood?", "answer": "Pulmonary Vein.", "hint": "From the lungs.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-26", "subject": "Anatomy & Physiology", "topic": "Blood", "question": "Universal Donor blood type?", "answer": "O Negative (O-).", "hint": "No A, B, or Rh antigens.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-27", "subject": "Anatomy & Physiology", "topic": "Blood", "question": "Universal Recipient blood type?", "answer": "AB Positive (AB+).", "hint": "No A, B, or Rh antibodies.", "difficulty": "Moderate", "isImportant": true },
