  { "id": "ap2-35", "subject": "Anatomy & Physiology", "topic": "Fluid/Acid-Base", "question": "Normal pH of blood?", "answer": "7.35 - 7.45.", "hint": "Slightly alkaline.", "difficulty": "Moderate", "isImportant": true },
  { "id": "ap2-36", "subject": "Anatomy & Physiology", "topic": "Endocrine", "question": "Hormone that increases blood calcium?", "answer": "Parathyroid Hormone (PTH).", "hint": "From parathyroid glands.", "difficulty": "Hard", "isImportant": true },
  { "id": "ap2-37", "subject": "Anatomy & Physiology", "topic": "Endocrine", "question": "Hormone that decreases blood calcium?", "answer": "Calcitonin.", "hint": "Produced by Thyroid C-cells.", "difficulty": "Hard", "isImportant": false },
  { "id": "ap2-38", "subject": "Anatomy & Physiology", "topic": "Endocrine", "question": "Primary hormone of the Adrenal Medulla?", "answer": "Epinephrine (Adrenaline).", "hint": "Fight or flight.", "difficulty": "Easy", "isImportant": false },
  { "id": "ap2-39", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "What is 'Systole'?", "answer": "Contraction of the heart chambers.", "hint": "Pumping phase.", "difficulty": "Easy", "isImportant": false },
  { "id": "ap2-40", "subject": "Anatomy & Physiology", "topic": "Cardiovascular", "question": "What is 'Diastole'?", "answer": "Relaxation and filling of the heart chambers.", "hint": "Resting phase.", "difficulty": "Easy", "isImportant": false },
